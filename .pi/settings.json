{
  "defaultProvider": "lmstudio",
  "defaultModel": "qwen/qwen3.6-35b-a3b",
  "enableSkillCommands": true,
  "packages": [
    "npm:pi-loop-police",
    "npm:@pi-unipi/compactor",
    "npm:@davehardy20/pi-compact-plus",
    "npm:pi-flutter-run"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 12000,
    "keepRecentTokens": 30000
  },
  "thresholds": {
    "checkpoint": 75,
    "standard": 80,
    "hard": 92
  },
  "cooldownMs": 120000,
  "experimentalToolOutputPruning": true,
  "toolOutputPruningMode": "agent-message",
  "toolOutputSummaryStrategy": "truncate",
  "toolOutputPruneStrategy": "stub"
}
